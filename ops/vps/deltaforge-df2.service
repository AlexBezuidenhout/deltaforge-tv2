[Unit]
Description=DeltaForge DF2 paper bot and dashboard
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/df2/current
EnvironmentFile=/etc/deltaforge/df2.env
Environment=NODE_ENV=production
Environment=DELTAFORGE_INSTANCE_ID=df2
Environment=BOT_RUNNER_ENABLED=false
Environment=DF2_ALLOW_AUTOSTART=false
Environment=DF2_RUNNER_ENABLED=false
ExecStart=/usr/local/bin/node src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
