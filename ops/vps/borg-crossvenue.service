[Unit]
Description=BORG Polymarket/Kalshi cross-venue laboratory (live data, paper only)
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=-/etc/deltaforge/evidence-epoch.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_CODE_VERSION=crossvenue-exact-rule-convergence-v6
Environment=CROSSVENUE_KALSHI_POLL_MS=2000
Environment=CROSSVENUE_MAX_MONITORED=200
Environment=CROSSVENUE_HOT_MONITORED=200
Environment=CROSSVENUE_EXPLORATORY_MONITORED=4
Environment=CROSSVENUE_PAPER_SCORE_APPROVAL=true
Environment=CROSSVENUE_PAPER_SCORE_FLOOR=0.80
Environment=CROSSVENUE_PAPER_APPROVED_AT=2026-07-19T21:14:45Z
Environment=CROSSVENUE_BROAD_POLL_MS=30000
Environment=CROSSVENUE_MAX_PAIR_SKEW_MS=250
Environment=CROSSVENUE_SYNC_HOLDBACK_MS=250
Environment=CROSSVENUE_BOOK_HISTORY_MS=30000
Environment=CROSSVENUE_BASIS_QUANTITY=5
Environment=CROSSVENUE_MAX_CANDIDATES=2000
Environment=CROSSVENUE_KALSHI_PAGES=20
Environment=CROSSVENUE_KALSHI_EVENT_PAGES=100
Environment=CROSSVENUE_KALSHI_EVENT_PACE_MS=250
Environment=CROSSVENUE_KALSHI_SERIES_PACE_MS=500
Environment=CROSSVENUE_GAMMA_PAGES=20
Environment=CROSSVENUE_GAMMA_WINDOWS=10
Environment=CROSSVENUE_POLY_SHARDS=4
Environment=CROSSVENUE_QUANTITIES=1,5,10,25,50,100
ExecStart=/usr/local/bin/node borg/crossvenue/collector.js
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
