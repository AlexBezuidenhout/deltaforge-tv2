[Unit]
Description=Score and archive BORG shadow orders
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service borg-collector.service

[Service]
Type=oneshot
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_ARCHIVE_MIN_FREE_GB=20
Environment=BORG_DB_HOT_RETENTION_HOURS=24
Environment=BORG_SCORE_ARCHIVE=0
ExecStart=/usr/local/bin/node borg/shadow/score.js --scheduled
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
