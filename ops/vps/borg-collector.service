[Unit]
Description=BORG append-before-process market-data collector
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=-/etc/deltaforge/evidence-epoch.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_ARCHIVE_MIN_FREE_GB=20
Environment=BORG_CODE_VERSION=priority-research-v14
# Paper/shadow only. Restrict the active decision fleet to the unchanged H43
# control and the two fresh, pre-registered successor hypotheses. Historical
# discovery arms remain immutable and queryable, but no longer consume compute
# or manufacture fresh multiple-testing rows in the priority epoch.
Environment=BORG_ACTIVE_STRATEGIES=H43_resolution_boundary_buffer,H43X_chainlink_tail_residual_v1,MAIN_LONGSHOT_0_20_V1
Environment=BORG_CAPTURE_ASSETS=btc,eth,sol,xrp
# All three active hypotheses consume five-minute books. Hourly, threshold and
# range authority is collected by the dedicated all-market/options/structural
# lanes; duplicating it here overloaded the primary socket and created real
# connection gaps without adding evidence for the frozen active strategy set.
Environment=BORG_CAPTURE_MARKET_TYPES=direction_5m
# v23 proved a four-token primary shard is repeatedly closed with code 1006
# despite fresh PONGs. Deterministic asset routing keeps each high-rate
# five-minute market's complementary pair on its own socket across rotations.
# This is a feed-integrity mechanism change, not a trading threshold.
Environment=BORG_CLOB_SHARDS=4
Environment=BORG_CLOB_HASH_VALIDATION_GRACE_MS=750
# Full event fidelity remains in compressed WAL. PostgreSQL stores at most one
# derived touch per token/250 ms, plus the trailing state, for fast queries.
Environment=BORG_CLOB_SQL_TOUCH_MIN_INTERVAL_MS=250
Environment=BORG_BOOK_SNAPSHOT_MS=5000
Environment=BORG_COLLECTION_BENCHMARK_FILE=/opt/deltaforge/tv2/current/borg/benchmarks/dublin-vps-2026-07-15.json
ExecStart=/usr/local/bin/node borg/recon/collector.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
