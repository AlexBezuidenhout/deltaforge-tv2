[Unit]
Description=BORG append-before-process market-data collector
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=-/etc/deltaforge/evidence-epoch.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_ARCHIVE_MIN_FREE_GB=20
Environment=BORG_CODE_VERSION=dublin-runtime-v3
Environment=BORG_ACTIVE_STRATEGIES=H43_resolution_boundary_buffer,ETH_G_late_exact_forward_v1
Environment=BORG_CAPTURE_ASSETS=btc,eth,sol,xrp
Environment=BORG_CAPTURE_MARKET_TYPES=direction_5m
# Full event fidelity remains in compressed WAL. PostgreSQL stores at most one
# derived touch per token/250 ms, plus the trailing state, for fast queries.
Environment=BORG_CLOB_SQL_TOUCH_MIN_INTERVAL_MS=250
Environment=BORG_BOOK_SNAPSHOT_MS=5000
Environment=BORG_COLLECTION_BENCHMARK_FILE=/opt/deltaforge/tv2/current/borg/benchmarks/dublin-vps-2026-07-15.json
ExecStart=/usr/local/bin/node borg/recon/collector.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
