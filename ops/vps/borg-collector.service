[Unit]
Description=BORG append-before-process market-data collector
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=-/etc/deltaforge/evidence-epoch.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_ARCHIVE_MIN_FREE_GB=20
Environment=BORG_CODE_VERSION=dublin-runtime-v9-h74-h75
# Paper/shadow only. The FWD_* identities are unchanged-rule prospective
# replications; their historical source IDs remain parked and their PnL is
# never pooled. H43 and the exact ETH arm continue their existing clocks.
# H64-H73 are the frozen V8 cohort; H74-H75 are the frozen V9
# minute-horizon, four-hour-state paper cohort.
Environment=BORG_ACTIVE_STRATEGIES=H43_resolution_boundary_buffer,ETH_G_late_exact_forward_v1,FWD_H24_hourly_flow_breakout_v1,FWD_H40_directional_entropy_breakout_v1,FWD_H44_hourly_midwindow_reversal_v1,FWD_H38_passive_flow_divergence_v1,FWD_H15_jump_adjusted_sigma_v1,FWD_H45_threshold_distance_velocity_v1,FWD_H46_range_boundary_migration_v1,FWD_H20_cross_venue_basis_reversion_v1,FWD_H7_btc_oracle_confirm_v1,FWD_H1_pair_arb_2x_v1,H54_dynamic_ofi_resolver_confirm,H55_ofi_guarded_passive_maker,H56_hawkes_excitation_continuation,H57_adaptive_venue_leader_residual,H58_resolver_event_stale_quote,H59_resolver_cross_persistence,H60_bipower_jump_envelope,H61_vol_regime_envelope,H62_threshold_isotonic_residual,H63_range_simplex_residual,H64_multivenue_cusum_break,H65_kalman_latent_consensus,H66_range_threshold_partition_lock,H67_queue_depletion_hazard,H68_multilevel_ofi_impact,H69_quarticity_confidence_envelope,H70_stationary_block_bootstrap_digital,H71_token_elasticity_residual,H72_crosshorizon_nested_lock,H73_market_prior_calibration_residual,H74_markov_regime_residual,H75_4h_dynamic_liquidity_leadlag
Environment=BORG_CAPTURE_ASSETS=btc,eth,sol,xrp
# H24/H44 require hourly books and H45/H46 require the nearest deterministic
# daily threshold/range panel. Six-hour activation would be false telemetry if
# the collector continued filtering those market families out.
Environment=BORG_CAPTURE_MARKET_TYPES=direction_5m,direction_15m,direction_1h,threshold_daily,range_daily
# Full event fidelity remains in compressed WAL. PostgreSQL stores at most one
# derived touch per token/250 ms, plus the trailing state, for fast queries.
Environment=BORG_CLOB_SQL_TOUCH_MIN_INTERVAL_MS=250
Environment=BORG_BOOK_SNAPSHOT_MS=5000
Environment=BORG_COLLECTION_BENCHMARK_FILE=/opt/deltaforge/tv2/current/borg/benchmarks/dublin-vps-2026-07-15.json
ExecStart=/usr/local/bin/node borg/recon/collector.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
