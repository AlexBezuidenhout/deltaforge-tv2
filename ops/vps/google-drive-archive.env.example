# Root-owned mode-0600 file installed as:
#   /etc/deltaforge/google-drive-archive.env
GDRIVE_RCLONE_REMOTE=deltaforge-gdrive
GDRIVE_ACCOUNT_LABEL=team@leadlabs.design
GDRIVE_ARCHIVE_PREFIX="VPS Data"
GDRIVE_RCLONE_CONFIG=/var/lib/deltaforge/google-drive-archive/rclone.conf
GDRIVE_RCLONE_BINARY=/usr/local/bin/rclone
GDRIVE_CUTOFF_SECONDS=300
GDRIVE_MAX_FILES_PER_RUN=5000
GDRIVE_MAX_BYTES_PER_RUN=26843545600
GDRIVE_TRANSFERS=8
GDRIVE_CHECKERS=8
GDRIVE_CHUNK_SIZE=64Mi
GDRIVE_TPS_LIMIT=16
GDRIVE_TPS_BURST=16
GDRIVE_HASH_WORKERS=2
