[Unit]
Description=Verify immutable DeltaForge archives directly in Google Drive
Wants=network-online.target
After=network-online.target deltaforge-raw-archive.service deltaforge-db-snapshot.service
ConditionPathExists=/etc/deltaforge/google-drive-archive.env
ConditionPathExists=/var/lib/deltaforge/google-drive-archive/rclone.conf

[Service]
Type=oneshot
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=/etc/deltaforge/google-drive-archive.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=DELTAFORGE_DB_SNAPSHOT_DIR=/var/lib/deltaforge/db-snapshots
Environment=GDRIVE_ARCHIVE_STATE_ROOT=/var/lib/deltaforge/google-drive-archive
Environment=BORG_OFFHOST_ARCHIVE_RECEIPT=/var/lib/deltaforge/google-drive-archive/receipts/offhost-archive.receipt
Environment=BORG_OFFHOST_SNAPSHOT_RECEIPT=/var/lib/deltaforge/google-drive-archive/receipts/offhost-snapshot.receipt
# Share one filesystem lock with local retention. This freezes the selected
# inode set for the duration of copy, hash and remote verification.
ExecStart=/usr/bin/flock --exclusive --wait 7200 /var/lib/deltaforge/.archive-retention.lock /usr/local/bin/node scripts/google-drive-archive.js
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/deltaforge
