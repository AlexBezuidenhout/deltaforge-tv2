[Unit]
Description=Polymarket public-flow paper scalp laboratory
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=-/etc/deltaforge/evidence-epoch.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_CODE_VERSION=dublin-runtime-v3
Environment=FLOW_REALTIME_MARKETS=4
Environment=FLOW_CLOB_ENABLED=false
Environment=FLOW_CLOB_SHARDS=4
Environment=FLOW_CLOB_PATHS_PER_ASSET=2
Environment=FLOW_CLOB_CONNECT_STAGGER_MS=3000
Environment=FLOW_CLOB_COVERAGE_MAX_AGE_MS=45000
Environment=FLOW_CLOB_REHYDRATE_AFTER_MS=5000
Environment=FLOW_CLOB_REHYDRATE_COOLDOWN_MS=15000
Environment=FLOW_GLOBAL_POLL_MS=2000
Environment=FLOW_DATA_TRADE_PAGE_SIZE=500
Environment=FLOW_DATA_TRADE_MAX_PAGES=4
Environment=FLOW_DATA_API_TIMEOUT_MS=20000
Environment=FLOW_REST_MAX_ATTEMPTS=4
Environment=FLOW_UNIVERSE_REFRESH_MS=60000
Environment=FLOW_STRATEGY_SIGNALS_ENABLED=false
ExecStart=/usr/local/bin/node borg/flow/collector.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
