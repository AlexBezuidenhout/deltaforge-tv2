[Unit]
Description=Polymarket public-flow paper scalp laboratory
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_COLLECTION_EPOCH_ID=dublin-local-pg-2026-07-16-v1
Environment=BORG_COLLECTION_EPOCH_START=2026-07-16T13:28:05.289Z
Environment=BORG_COLLECTION_LOCATION=dublin-ie
Environment=BORG_CODE_VERSION=dublin-runtime-v3
Environment=FLOW_REALTIME_MARKETS=4
Environment=FLOW_CLOB_SHARDS=2
Environment=FLOW_GLOBAL_POLL_MS=2000
Environment=FLOW_DATA_TRADE_PAGE_SIZE=500
Environment=FLOW_DATA_TRADE_MAX_PAGES=4
Environment=FLOW_UNIVERSE_REFRESH_MS=60000
ExecStart=/usr/local/bin/node borg/flow/collector.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
