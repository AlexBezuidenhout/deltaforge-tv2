[Unit]
Description=Capture cross-venue settlement outcomes from Kalshi and Polymarket
Requires=postgresql.service
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node scripts/cv-settle.js
# Evidence-epoch cutovers deliberately drain this bounded poller. Treat that
# operator-initiated SIGTERM as a clean stop; the next explicit run still has
# to exit zero, so genuine settlement failures remain visible.
SuccessExitStatus=SIGTERM
Nice=10
