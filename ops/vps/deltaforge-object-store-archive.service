[Unit]
Description=Verify immutable DeltaForge archives in S3-compatible off-host storage
Wants=network-online.target
After=network-online.target deltaforge-raw-archive.service deltaforge-db-snapshot.service
ConditionPathExists=/etc/deltaforge/object-store.env

[Service]
Type=oneshot
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=/etc/deltaforge/object-store.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive/borg-raw
Environment=DELTAFORGE_DB_SNAPSHOT_DIR=/var/lib/deltaforge/db-snapshots
Environment=ARCHIVE_S3_STATE_ROOT=/var/lib/deltaforge/object-store-archive
Environment=BORG_OFFHOST_ARCHIVE_RECEIPT=/var/lib/deltaforge/offhost-archive.receipt
Environment=BORG_OFFHOST_SNAPSHOT_RECEIPT=/var/lib/deltaforge/offhost-snapshot.receipt
ExecStart=/usr/local/bin/node scripts/object-store-archive.js
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

