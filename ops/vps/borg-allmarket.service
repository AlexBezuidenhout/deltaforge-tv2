[Unit]
Description=BORG all-market L2 and passive-making laboratory (paper only)
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_COLLECTION_EPOCH_ID=dublin-local-pg-2026-07-16-v1
Environment=BORG_COLLECTION_EPOCH_START=2026-07-16T13:28:05.289Z
Environment=BORG_COLLECTION_LOCATION=dublin-ie
Environment=BORG_CODE_VERSION=dublin-runtime-v3
Environment=ALLMARKET_MAX_MARKETS=10
Environment=ALLMARKET_GAMMA_PAGES=20
Environment=ALLMARKET_GAMMA_WINDOWS=10
Environment=ALLMARKET_PERSIST_MARKETS=5000
Environment=ALLMARKET_SQL_TOUCH_MIN_INTERVAL_MS=100
Environment=ALLMARKET_CLOB_SHARDS=2
Environment=ALLMARKET_LATENCY_PROFILES_MS=20,50,100,250,500
Environment=ALLMARKET_MAX_CAPITAL_PER_MARKET=50
Environment=ALLMARKET_CATALYST_GUARD_HOURS=6
Environment=ALLMARKET_NO_FAIR_FEED_GUARD_HOURS=24
Environment=ALLMARKET_FAIR_FEED_CATEGORIES=
ExecStart=/usr/local/bin/node borg/allmarket/collector.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
