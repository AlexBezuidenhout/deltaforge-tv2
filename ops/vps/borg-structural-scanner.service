[Unit]
Description=BORG event-driven structural payoff scanner (paper only)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaforge
Group=deltaforge
WorkingDirectory=/opt/deltaforge/tv2/current
EnvironmentFile=/etc/deltaforge/tv2.env
EnvironmentFile=-/etc/deltaforge/evidence-epoch.env
Environment=NODE_ENV=production
Environment=BORG_WAL_DIR=/var/lib/deltaforge/wal/borg
Environment=BORG_WAL_MIN_FREE_GB=20
Environment=BORG_CODE_VERSION=structural-certified-payoff-v4-capacity
Environment=STRUCTURAL_MAX_CANDIDATES=48
Environment=STRUCTURAL_MAX_TOKENS=128
Environment=STRUCTURAL_CLOB_SHARDS=4
Environment=STRUCTURAL_EVENT_PAGES=20
Environment=STRUCTURAL_GAMMA_CONCURRENCY=4
Environment=STRUCTURAL_GAMMA_TIMEOUT_MS=30000
Environment=STRUCTURAL_GAMMA_MAX_ATTEMPTS=4
Environment=STRUCTURAL_LATENCY_PROFILES_MS=20,50,100,250,500
Environment=STRUCTURAL_TARGET_NOTIONAL_USD=10
Environment=STRUCTURAL_MIN_CAPACITY_PROFIT_USD=0.05
Environment=STRUCTURAL_NEGATIVE_SAMPLE_MS=5000
Environment=STRUCTURAL_POSITIVE_SAMPLE_MS=100
ExecStart=/usr/local/bin/node borg/structural/scanner.js
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
