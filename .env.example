# Core application
NODE_ENV=development
HOST=127.0.0.1
PORT=3004
FRONTEND_URL=http://localhost:3004

# PostgreSQL. Use a dedicated development database; never commit a real URL.
DATABASE_URL=postgresql://deltaforge:replace_me@127.0.0.1:5432/deltaforge
# Optional direct/non-pooler endpoint for advisory locks and maintenance.
DATABASE_URL_DIRECT=postgresql://deltaforge:replace_me@127.0.0.1:5432/deltaforge
# Optional read replica/restored research copy. Reporting scripts prefer this
# URL and force read-only, single-connection, bounded-timeout sessions so an
# analytical scan cannot queue ingestion or partition maintenance.
ANALYTICS_DATABASE_URL=
DB_SSL_REJECT_UNAUTHORIZED=false

# Authentication and encryption
# Generate JWT_SECRET with: openssl rand -hex 32
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_characters
ENCRYPTION_KEY=replace_with_64_hex_characters
DISABLE_AUTH=false
ALLOW_REGISTRATION=false
DEFAULT_USER_ID=1
# Viewer accounts authenticate as themselves but read this operator's data.
VIEWER_TARGET_USER_ID=1

# Optional public RPCs. Omit to use the application's public fallbacks.
POLYGON_RPC_URL=
ETH_RPC_URL=

# Research storage. Keep WAL and Parquet outside the repository.
BORG_WAL_DIR=/var/lib/deltaforge/wal
BORG_PARQUET_MIRROR_DIR=/var/lib/deltaforge/parquet
BORG_ARCHIVE_DIR=/var/lib/deltaforge/archive
BORG_SHADOW=true

# Frozen priority research artifacts and query-tier persistence. H43-X fails
# closed when its pre-cutoff model file is absent, invalid or underpowered.
BORG_H43X_TAIL_MODEL=/var/lib/deltaforge/models/h43x-resolver-tail-v1.json
OPTIONS_REQUIRE_EXACT_EXPIRY=true
OPTIONS_DIAGNOSTIC_HEARTBEAT_MS=300000
OPTIONS_EXECUTABLE_HEARTBEAT_MS=60000
OPTIONS_MARK_TRANSITION_DWELL_MS=250
# Public-flow books use one logical shard per selected market and two independent
# paths per token. This avoids combining several high-throughput books on one
# socket while retaining aggregate coverage through one transport reset.
FLOW_CLOB_ENABLED=false
FLOW_CLOB_SHARDS=4
FLOW_CLOB_PATHS_PER_ASSET=2
FLOW_CLOB_CONNECT_STAGGER_MS=3000
FLOW_CLOB_COVERAGE_MAX_AGE_MS=45000
FLOW_CLOB_REHYDRATE_AFTER_MS=5000
FLOW_CLOB_REHYDRATE_COOLDOWN_MS=15000
# Exact Pyth rule symbols are resolved against the Hermes Core catalog and
# streamed by feed id. Authentication is optional until Pyth requires it; keep
# any real API key only in the sealed VPS environment.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_HERMES_CONNECT_TIMEOUT_MS=15000

# Optional verified off-host archive. Compatible with AWS S3, Cloudflare R2,
# Backblaze B2 and other S3 APIs. Retention receipts are issued only after
# every eligible immutable raw object has a matching remote size and SHA-256.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_PREFIX=deltaforge/dublin
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_FORCE_PATH_STYLE=false

# Live trading remains locked by default. Do not place wallet secrets here in
# a shared clone; configure them only on the private runtime host.
LIVE_TRADING_ENABLED=false
